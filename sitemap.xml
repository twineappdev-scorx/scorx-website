---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <url>
    <loc>{{ site.url }}/sports/afl</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>

  <url>
    <loc>{{ site.url }}/sports/netball</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>

  {% for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    <changefreq>never</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}

  {% for page in site.pages %}
    {%- assign skip = false -%}
    {%- if page.url == '/' or page.url == '/404.html' or page.url == '/match/' -%}
      {%- assign skip = true -%}
    {%- endif -%}
    {%- if page.url contains '/documentation/' or page.url contains 'sitemap' -%}
      {%- assign skip = true -%}
    {%- endif -%}
    {%- unless skip -%}
      {%- if page.url contains '.html' or page.url == '/blog/' %}
  <url>
    <loc>{{ site.url }}{{ page.url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        {%- if page.url contains 'privacy' or page.url contains 'terms' %}
    <changefreq>yearly</changefreq>
    <priority>0.4</priority>
        {%- elsif page.url contains 'features' or page.url contains 'pricing' or page.url contains 'download' %}
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
        {%- elsif page.url == '/blog/' %}
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
        {%- else %}
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
        {%- endif %}
  </url>
      {%- endif %}
    {%- endunless %}
  {% endfor %}

</urlset>
